<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_background"
    android:padding="14dp"
    android:gravity="center_vertical"
    android:theme="@style/Theme.Lytrix.Widget">

    <LinearLayout
        android:id="@+id/widget_insights_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <ImageView
            android:id="@+id/widget_insights_art"
            android:layout_width="46dp"
            android:layout_height="46dp"
            android:scaleType="centerCrop"
            android:src="@drawable/widget_insights_badge"
            android:contentDescription="Listening insights" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="10dp"
            android:layout_marginEnd="8dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/widget_insights_heading"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Listening Insights"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="@color/widget_text_primary"
                android:maxLines="1"
                android:ellipsize="end"
                android:includeFontPadding="false" />

            <TextView
                android:id="@+id/widget_insights_now_playing"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Tap to open your stats"
                android:textSize="12sp"
                android:textColor="@color/widget_text_secondary"
                android:maxLines="1"
                android:ellipsize="end"
                android:includeFontPadding="false" />
        </LinearLayout>

        <FrameLayout
            android:id="@+id/widget_insights_play_container"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/widget_turntable_play_bg">

            <ImageView
                android:id="@+id/widget_insights_play_pause"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_widget_play"
                android:contentDescription="Play or pause" />
        </FrameLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:baselineAligned="false"
        android:orientation="horizontal">

        <LinearLayout style="@style/LytrixWidgetStatPill">
            <TextView
                android:id="@+id/widget_insights_today_value"
                style="@style/LytrixWidgetStatValue"
                android:text="0m" />
            <TextView
                style="@style/LytrixWidgetStatLabel"
                android:text="TODAY" />
        </LinearLayout>

        <LinearLayout
            style="@style/LytrixWidgetStatPill"
            android:layout_marginStart="6dp"
            android:layout_marginEnd="6dp">
            <TextView
                android:id="@+id/widget_insights_week_value"
                style="@style/LytrixWidgetStatValue"
                android:text="0m" />
            <TextView
                style="@style/LytrixWidgetStatLabel"
                android:text="7 DAYS" />
        </LinearLayout>

        <LinearLayout style="@style/LytrixWidgetStatPill">
            <TextView
                android:id="@+id/widget_insights_streak_value"
                style="@style/LytrixWidgetStatValue"
                android:text="0d" />
            <TextView
                style="@style/LytrixWidgetStatLabel"
                android:text="STREAK" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/widget_insights_footer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal"
        android:background="@drawable/widget_tile_bg"
        android:paddingStart="12dp"
        android:paddingEnd="8dp"
        android:paddingTop="7dp"
        android:paddingBottom="7dp"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/widget_insights_top_line"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Top: —"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="@color/widget_text_primary"
            android:maxLines="1"
            android:ellipsize="end"
            android:includeFontPadding="false" />

        <ImageView
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:src="@drawable/ic_widget_chevron"
            android:contentDescription="@null" />
    </LinearLayout>
</LinearLayout>
