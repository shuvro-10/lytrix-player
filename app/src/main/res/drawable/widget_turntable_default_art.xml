<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="oval">
            <gradient
                android:angle="135"
                android:startColor="#26314A"
                android:centerColor="#39496B"
                android:endColor="#53668E"
                android:type="linear" />
        </shape>
    </item>
    <item android:left="14dp" android:top="14dp" android:right="14dp" android:bottom="14dp">
        <shape android:shape="oval">
            <stroke android:width="1dp" android:color="#30FFFFFF" />
            <solid android:color="#00000000" />
        </shape>
    </item>
    <item android:left="48dp" android:top="48dp" android:right="48dp" android:bottom="48dp">
        <shape android:shape="oval">
            <solid android:color="#26000000" />
            <stroke android:width="1dp" android:color="#35FFFFFF" />
        </shape>
    </item>
    <item android:drawable="@drawable/ic_widget_music_note" android:gravity="center"
        android:width="36dp" android:height="36dp" />
</layer-list>
